-- Потоки
local threads = {}

local function startThread(name, func)
    if threads[name] then task.cancel(threads[name]) end
    threads[name] = task.spawn(func)
end

local function stopThread(name)
    if threads[name] then task.cancel(threads[name]); threads[name] = nil end
end

-- Вспомогательные функции
local function teleportTo(pos)
    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CFrame = pos end
end

local function pressE()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.1)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

local function findPlayerTycoon()
    for _, tycoon in pairs(Workspace.Tycoon.Tycoons:GetChildren()) do
        if tycoon:FindFirstChild("Owner") and tycoon.Owner.Value == lp then
            return tycoon
        end
    end
    return nil
end

local function getCurrentCash()
    local stats = lp:FindFirstChild("leaderstats")
    if stats then
        local cash = stats:FindFirstChild("Cash")
        if cash then return cash.Value end
    end
    return 0
end

local function isGreenButton(btn)
    local neon = btn:FindFirstChild("Neon") or btn:FindFirstChild("Button")
    if neon and neon:IsA("BasePart") then
        local color = neon.Color
        return (color.G > color.R and color.G > color.B)
    end
    return false
end

local function getPromptAtPosition(pos, radius)
    radius = radius or 15
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parent = obj.Parent
            local part = nil
            if parent:IsA("BasePart") then part = parent
            elseif parent:IsA("Model") then
                part = parent:FindFirstChild("PrimaryPart") or parent:FindFirstChildWhichIsA("BasePart")
            end
            if part then
                local dist = (part.Position - pos).Magnitude
                if dist <= radius then return obj end
            end
        end
    end
    return nil
end

local function getSellPosition()
    for _, tycoon in pairs(Workspace.Tycoon.Tycoons:GetChildren()) do
        if tycoon:FindFirstChild("Owner") and tycoon.Owner.Value == lp then
            local oc = tycoon:FindFirstChild("Essentials") and tycoon.Essentials:FindFirstChild("Oil Collector")
            if oc then
                local plane = oc:FindFirstChild("Collector") and oc.Collector:FindFirstChild("Plane")
                if plane then return plane.CFrame * CFrame.new(0, 3, 0) end
            end
            break
        end
    end
    local spawn = Workspace:FindFirstChild("SpawnLocation")
    if spawn then return spawn.CFrame * CFrame.new(0, 3, 0) end
    return nil
end

local function holdEOnPrompt(prompt, duration)
    if not prompt then return end
    prompt:InputHoldBegin()
    task.wait(duration)
    prompt:InputHoldEnd()
end

-- === ФУНКЦИИ ФАРМА ===

-- 1. Auto Buy Buttons
local function autoBuyLoop()
    while state.autoBuy do
        local tycoon = findPlayerTycoon()
        if not tycoon then task.wait(2) continue end
        local unpurchased = tycoon:FindFirstChild("UnpurchasedButtons")
        if not unpurchased then task.wait(1) continue end

        local bought = false
        local greenButtons = {}
        for _, btn in pairs(unpurchased:GetChildren()) do
            if isGreenButton(btn) then table.insert(greenButtons, btn) end
        end

        if #greenButtons > 0 then
            local chosen = greenButtons[math.random(1, #greenButtons)]
            local part = chosen:FindFirstChild("Neon") or chosen:FindFirstChild("Button")
            if part then
                teleportTo(part.CFrame * CFrame.new(0, 5, 0))
                task.wait(0.3)
                pressE()
                task.wait(0.5)
                bought = true
            end
        end

        if not bought then
            local cash = getCurrentCash()
            if cash > 0 then
                for _, btn in pairs(unpurchased:GetChildren()) do
                    local part = btn:FindFirstChild("Neon") or btn:FindFirstChild("Button")
                    if part then
                        teleportTo(part.CFrame * CFrame.new(0, 5, 0))
                        task.wait(0.3)
                        pressE()
                        task.wait(0.5)
                        break
                    end
                end
            end
        end
        task.wait(0.5)
    end
end

-- 2. Auto Collect Cash
local function autoCollectLoop()
    while state.autoCollect do
        local tycoon = findPlayerTycoon()
        if not tycoon then task.wait(2) continue end
        local cashCollector = tycoon:FindFirstChild("Essentials") and tycoon.Essentials:FindFirstChild("CashCollector")
        if cashCollector then
            teleportTo(cashCollector.CFrame * CFrame.new(0, 5, 0))
            task.wait(0.3)
            pressE()
            task.wait(0.5)
        end
        task.wait(1)
    end
end

-- 3. Auto Oil Extractors
local function findAllOilBarrels()
    local barrels = {}
    local gs = Workspace:FindFirstChild("Game Systems")
    if not gs then return barrels end
    local cw = gs:FindFirstChild("Collectibles Workspace")
    if not cw then return barrels end
    local oilFolder = cw:FindFirstChild("OilBarrel")
    if not oilFolder then return barrels end
    for _, child in pairs(oilFolder:GetChildren()) do
        local pos = nil
        if child:IsA("BasePart") then pos = child.Position
        elseif child:IsA("Model") then
            local prim = child:FindFirstChild("PrimaryPart") or child:FindFirstChildWhichIsA("BasePart")
            if prim then pos = prim.Position end
        end
        if pos then table.insert(barrels, pos) end
    end
    return barrels
end

local function getSellPromptAtPosition(pos)
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local parent = obj.Parent
            local part = nil
            if parent:IsA("BasePart") then part = parent
            elseif parent:IsA("Model") then part = parent:FindFirstChild("PrimaryPart") or parent:FindFirstChildWhichIsA("BasePart")
            end
            if part then
                local dist = (part.Position - pos).Magnitude
                if dist <= 30 then return obj end
            end
        end
    end
    return nil
end

local function autoOilLoop()
    while state.autoOil do
        local sellPos = getSellPosition()
        if not sellPos then task.wait(2) continue end
        local barrels = findAllOilBarrels()
        if #barrels == 0 then task.wait(2) continue end

        for _, pos in ipairs(barrels) do
            if not state.autoOil then break end
            teleportTo(CFrame.new(pos))
            task.wait(0.5)
            local prompt = getPromptAtPosition(pos)
            if prompt then holdEOnPrompt(prompt, 6) end
            task.wait(0.5)
            teleportTo(sellPos)
            task.wait(0.5)
            local sellPrompt = getSellPromptAtPosition(sellPos.Position)
            if sellPrompt then holdEOnPrompt(sellPrompt, 3) else pressE() end
            task.wait(0.5)
        end
        task.wait(1)
    end
end

-- 4. Auto Airdrops
local function findAllAirdrops()
    local drops = {}
    local gs = Workspace:FindFirstChild("Game Systems")
    if not gs then return drops end
    local cw = gs:FindFirstChild("Collectibles Workspace")
    if not cw then return drops end
    local adFolder = cw:FindFirstChild("AirDrop")
    if not adFolder then return drops end
    for _, child in pairs(adFolder:GetChildren()) do
        if child.Name:match("^Airdrop_") then
            local mainPart = nil
            local parts = child:FindFirstChild("Parts")
            if parts then mainPart = parts:FindFirstChild("MainPart") end
            if not mainPart then mainPart = child:FindFirstChild("MainPart") end
            if mainPart and mainPart:IsA("BasePart") then
                table.insert(drops, mainPart.Position)
            end
        end
    end
    return drops
end

local function autoAirdropLoop()
    while state.autoAirdrop do
        local drops = findAllAirdrops()
        if #drops > 0 then
            for _, pos in ipairs(drops) do
                if not state.autoAirdrop then break end
                teleportTo(CFrame.new(pos + Vector3.new(0, 5, 0)))
                task.wait(0.5)
                local prompt = getPromptAtPosition(pos)
                if prompt then holdEOnPrompt(prompt, 6) end
                task.wait(0.5)
                local char = lp.Character
                if char and char:FindFirstChild("Humanoid") then
                    char.Humanoid.Health = 0
                    task.wait(2)
                end
                task.wait(0.5)
            end
        else
            task.wait(2)
        end
        task.wait(1)
    end
end

-- 5. Auto Rebirth
local function autoRebirthLoop()
    while state.autoRebirth do
        local stats = lp:FindFirstChild("leaderstats")
        if stats then
            local rebirths = stats:FindFirstChild("Rebirths")
            local prestige = stats:FindFirstChild("Prestige")
            local reb = rebirths or prestige
            if reb then
                local tycoon = findPlayerTycoon()
                if tycoon then
                    local rebBtn = tycoon:FindFirstChild("RebirthButton") or tycoon:FindFirstChild("PrestigeButton")
                    if rebBtn and rebBtn:IsA("BasePart") then
                        teleportTo(rebBtn.CFrame * CFrame.new(0, 5, 0))
                        task.wait(0.3)
                        pressE()
                        task.wait(1)
                    end
                end
            end
        end
        task.wait(10)
    end
end

-- 6. Auto Redeem Daily
local function autoDailyLoop()
    while state.autoDaily do
        local dailyBtn = lp.PlayerGui:FindFirstChild("DailyRewardButton")
        if dailyBtn and dailyBtn:IsA("TextButton") then
            dailyBtn:Click()
        end
        task.wait(3600)
    end
end

-- 7. Auto Spin Wheel
local function autoSpinLoop()
    while state.autoSpin do
        local wheel = Workspace:FindFirstChild("SpinWheel") or Workspace:FindFirstChild("FortuneWheel")
        if wheel then
            local prompt = wheel:FindFirstChildWhichIsA("ProximityPrompt")
            if prompt then
                teleportTo(wheel.PrimaryPart.CFrame * CFrame.new(0, 5, 0))
                task.wait(0.5)
                holdEOnPrompt(prompt, 3)
            end
        end
        task.wait(3600)
    end
end

-- 8. Auto Heal
local function autoHealLoop()
    while state.autoHeal do
        local char = lp.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            if hum and hum.Health < hum.MaxHealth * 0.3 then
                local medkit = lp.Backpack:FindFirstChild("Medkit")
                if medkit then
                    lp.Character.Humanoid:EquipTool(medkit)
                    task.wait(0.2)
                    medkit:Activate()
                end
            end
        end
        task.wait(1)
    end
end

-- 9. Put on Best Armor
local function autoUpgradeLoop()
    while state.autoUpgrade do
        local char = lp.Character
        if char then
            local bestArmor = nil
            local bestValue = 0
            for _, item in pairs(lp.Backpack:GetChildren()) do
                if item:IsA("Tool") and item.Name:find("Armor") then
                    local def = item:GetAttribute("Defense") or tonumber(item.Name:match("%d+")) or 0
                    if def > bestValue then
                        bestValue = def
                        bestArmor = item
                    end
                end
            end
            if bestArmor then
                lp.Character.Humanoid:EquipTool(bestArmor)
            end
        end
        task.wait(10)
    end
end

-- 10. Player ESP
local function playerESPLoop()
    while state.playerESP do
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= lp and player.Character then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if not hrp:FindFirstChild("ESPBox") then
                        local box = Instance.new("BoxHandleAdornment")
                        box.Size = Vector3.new(4, 4, 4)
                        box.Adornee = hrp
                        box.Color3 = Color3.new(1, 0, 0)
                        box.Transparency = 0.5
                        box.ZIndex = 0
                        box.Name = "ESPBox"
                        box.Parent = hrp
                    end
                end
            end
        end
        task.wait(1)
    end
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local box = hrp:FindFirstChild("ESPBox")
                if box then box:Destroy() end
            end
        end
    end
end

-- 11. Vehicle ESP
local function vehicleESPLoop()
    while state.vehicleESP do
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("VehicleSeat") or obj:IsA("Model") and obj:FindFirstChildWhichIsA("VehicleSeat") then
                local vehicle = obj.Parent
                if vehicle and not vehicle:FindFirstChild("VehicleESP") then
                    local box = Instance.new("BoxHandleAdornment")
                    box.Size = Vector3.new(10, 5, 10)
                    box.Adornee = vehicle:FindFirstChild("PrimaryPart") or vehicle:FindFirstChildWhichIsA("BasePart")
                    box.Color3 = Color3.new(0, 1, 0)
                    box.Transparency = 0.5
                    box.ZIndex = 0
                    box.Name = "VehicleESP"
                    box.Parent = vehicle
                end
            end
        end
        task.wait(1)
    end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "VehicleESP" then obj:Destroy() end
    end
end

-- 12. Anti-AFK
local function antiAFKLoop()
    while state.antiAFK do
        task.wait(120)
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
    end
end

-- 13. Lag Reducer
local function lagReducerLoop()
    while state.lagReducer do
        RunService:Set3dRenderingEnabled(false)
        task.wait()
    end
    RunService:Set3dRenderingEnabled(true)
end

-- 14. Debug Mode
local function debugLoop()
    while state.debugMode do
        print("Runtime:", os.time() - startTime)
        task.wait(10)
    end
end

