-- Состояния для тогглов
local state = {
    autoBuy = false,
    autoCollect = false,
    autoOil = false,
    autoAirdrop = false,
    autoUpgrade = false,
    autoRebirth = false,
    autoDaily = false,
    autoSpin = false,
    autoHeal = false,
    playerESP = false,
    vehicleESP = false,
    antiAFK = false,
    lagReducer = false,
    debugMode = false,
