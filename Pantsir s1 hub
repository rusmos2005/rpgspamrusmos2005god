local function findAllTargets()
    local targets = {}
    local tycoonsContainer = Workspace:FindFirstChild("Tycoon")
    if not tycoonsContainer then return targets end
    local tycoons = tycoonsContainer:FindFirstChild("Tycoons")
    if not tycoons then return targets end
    for _, tycoon in pairs(tycoons:GetChildren()) do
        for _, obj in pairs(tycoon:GetDescendants()) do
            local name = obj.Name
            if name:match("^Effect") or name == "Base Shield" or name == "CRAM" or name == "ElectricalBox" or name == "Spawn Visualizer" then
                local attackPart = nil
                if obj:IsA("BasePart") then
                    attackPart = obj
                else
                    local part = obj:FindFirstChildWhichIsA("BasePart")
                    if part then attackPart = part end
                end
                if attackPart then
                    table.insert(targets, attackPart)
                end
            end
        end
    end
    return targets
end

local function fireAtTarget(targetPart)
    local char = lp.Character
    if not char then return end
    local rpg = char:FindFirstChild("RPG") or (lp.Backpack and lp.Backpack:FindFirstChild("RPG"))
    if not rpg then return end
    for _ = 1, 10 do
        pcall(function()
